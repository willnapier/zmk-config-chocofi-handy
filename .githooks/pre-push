#!/usr/bin/env bash
# Fires before the push that triggers the GHA build that produces the UF2 you
# are about to flash. Advisory only — never blocks.
#
# Added 2026-08-27 at Will's request, so the deferred keymap guards are not
# silently deferred forever. Delete this hook once they are guarded.

changed=$(git diff --name-only @{push}..HEAD 2>/dev/null || git diff --name-only origin/main..HEAD 2>/dev/null)
echo "$changed" | rg -q "config/chocofi.keymap" || exit 0

# Only warn if a destructive binding is still on a BARE LAYER KEY. Combo
# bindings live on their own `bindings = <...>;` line, so excluding those
# distinguishes "guarded" from "unguarded". Without this test the hook fired
# on every keymap push, including the one that fixed the problem - and a
# guard that always fires trains you to ignore it.
unguarded=$(rg -n '&(bt BT_CLR_ALL|bootloader)' config/chocofi.keymap \
    | rg -v 'bindings = <' | rg -v '^\s*[0-9]+:\s*\*' | rg -v '^\s*[0-9]+:\s*/\*')

if [ -z "$unguarded" ]; then
    exit 0
fi

cat <<'BANNER'
┌──────────────────────────────────────────────────────────────────────┐
│  KEYMAP CHANGE → this push builds a UF2 you will flash.              │
│  A DESTRUCTIVE BINDING IS ON A BARE KEY:                             │
└──────────────────────────────────────────────────────────────────────┘
BANNER
echo "$unguarded"
cat <<'BANNER'

  Guard it behind a deliberate combo. Keep BT_CLR_ALL reachable — it is
  the only in-band bond clear, and on bf81949 its absence was the problem.

  Guarded as of 2026-08-28:
    combo_bt_clr     HELIX, positions 15+19 (both ends of the home row)
    combo_bootloader HELIX, positions 8+9   (Y + ')

  Background: ~/Assistants/shared/ZMK-HANDY-REMOTE-LESSONS.md

  (advisory only — the push continues)
BANNER

exit 0
